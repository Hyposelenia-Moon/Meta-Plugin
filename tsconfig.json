{
  // Meta-Plugin：插件区（src/ → lib/）。
  // 维护者区（scripts/、templates/、test/）是 ESM JS，不参与编译 —— 见设计文档 §4.1。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,
    "declaration": false,
    "removeComments": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
