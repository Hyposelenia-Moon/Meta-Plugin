# 依赖
node_modules/

# 配置文件：运行时 config.yaml 不入库；config.yaml.example 入库（首次启动自动复制）
config/config.yaml

# 操作系统临时文件
.DS_Store
Thumbs.db

# 编辑器配置
.vscode/
.idea/

# Claude Code / DeepSeek Harness 工作区
.claude/
.dsh/
CLAUDE.md
AGENTS.md
.plugin-v2/
.plugin-v2-dev/
.plugin-v2-final/
.plugin-v2-final-dev/
.plugin-conflict/
.tmp/
out/

# 编辑器批量替换的安全副本（本地快照，不进版本库）
data/_backup/

# 软删除回收站（本地暂存，不进版本库）
data/_trash/

# 解析中间产物（本地生成，不进版本库；data/_index.json 例外：它要继续入库）
data/_parse-report.json

# 商业字体（本地保留即可，不随仓库分发；guide.html 按相对路径引用它）
汉仪文黑-85W.ttf
*.ttf
*.otf
# ⚠ 例外：榜单/危战/状态页的页脚数字字体（合并自 Mhydps，仅 19.6 KB，页面 @font-face 依赖它，必须入库）
!resources/common/font/*.ttf

# 回归套件临时产物
test/.test-tmp/

# pnpm 锁文件：由 bot 根的工作区统一生成与管理，插件目录自己不该有一份
# （出现即说明有人在插件内跑过 install；node_modules 同理不入库）
pnpm-lock.yaml

# ⚠ 编译产物 lib/ **必须入库**（bot 侧只允许 git pull，见设计文档 §4.1）——不要加进本文件；
#   `test/lib-fresh.test.mjs` 会检查它是否落后于 src/。
