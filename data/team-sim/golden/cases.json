  "schemaVersion": 1,
  "note": "发布闸门的黄金集：单发直伤、固定 90 级攻击者 / 110 级目标、crit 取期望值。期望值全部手算，推导写在每个用例的 source 里；来源不可考的用例不计入闸门（见 src/modules/teamSimulation/metrics.ts 的注释）。实跑值由 scripts/audit-golden.mjs 写入同目录 actuals.json。",
  "formula": {
    "damage": "base × (1 + damageBonus) × crit × defense × resistance",
    "base": "Σ(stat × multiplier) + additiveBase",
    "crit": "canCrit 为 false 或 crit=non-critical 时取 1；critical 时 1+critDamage；expected 时 1+min(1,max(0,critRate))×critDamage",
    "defense": "(attackerLevel+100) / ((attackerLevel+100) + (enemyLevel+100) × (1−min(0.9,defenseReduction)) × (1−defenseIgnore))",
    "resistance": "effective = resistance − resistanceReduction；< 0 时 1−effective/2，≥ 0.75 时 1/(1+4×effective)，其余 1−effective"
  },
