# Meta-Plugin 运行时配置（参考默认值）
# 首次启动若没有 config/config.yaml，会自动复制本文件；锅巴保存会按 defSet/config.yaml 模板重写它
# 键的含义见 defSet/config.yaml 的注释；本文件的值必须与 src/components/config.ts 的 defaultConfig 一致
# （test/config.test.mjs 会逐字段核对）

# 常规查询命令的优先级（数字越小越先执行）
# ⚠ 攻略模块的「抢占用」优先级写死为 -100000，不在此处暴露
priority: 8000

# 渲染缩放比例
renderScale: 1.5

# 模块开关（功能层：该模块的命令是否响应）
# true = 可用；false = 不响应（非接管类回提示；接管类「#胡桃攻略 / 帮助页」放行给其他插件）
# ⚠ 与下面的 networkEnabled（只管查询类远程访问）正交
modules:
  codex: true
  help: true
  rank: true
  raidTiers: true
  grade: true
  # 队伍伤害：默认关闭（用户 2026-10-15 定）
  teamDamage: false
  video: true
  status: true
  admin: true

# 业务查询联网开关（默认关闭）
# 只管辖 DPS 榜 / 危战 / 练度等业务查询的远程访问与刷新；**不是**整个插件的全局联网禁令
networkEnabled: false

# 抓取 mhydps.cn 的代理，留空 = 直连
proxy: ""

# 榜单单次请求超时（毫秒）
dpsTimeoutMs: 30000

# 榜单数据缓存有效期（分钟）
dpsCacheTtlMinutes: 30

# 榜单每页条数
dpsPageSize: 10

# 是否缓存并渲染角色立绘
dpsAvatarEnabled: true

# 练度评分权重（已废弃：2026-11-02 起权重写死 —— 输出 圣遗物45/武器25/天赋25/等级5，辅助 面板45/武器25/天赋25/等级5）
gradeWeights: "comprehensive:65,weapon:20,talent:15"

# 面板三档阈值（唯一仍可调的练度项）：大毕业 / 毕业 / 小毕业（按面板目标平均达成度）
gradePanelTiers: "big:0.9,normal:0.6,small:0.3"

# 总体练度九档阈值（2026-11-02 起写死，本项已废弃、不再生效，保留只为旧配置可读）
gradeRankThresholds: "MAX:100,ACE:90,SSS:80,SS:70,S:60,A:50,B:40,C:30,D:20"

# 旧评分规则（已废弃：新版按攻略预设与 miao 规则名称匹配，不再读本项）
gradeRule: "auto"

# 逐角色覆盖（已废弃，同上）
gradeRuleOverrides: ""

# 队伍伤害的序号轴表（已废弃：内置序号轴已废除，改用录制轴文件；字段保留只为旧配置可读）
teamDamageAxes: "1:保守轴=默认"
