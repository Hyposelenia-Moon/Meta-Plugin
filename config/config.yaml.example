# Meta-Plugin 运行时配置（参考默认值）
# 首次启动若没有 config/config.yaml，会自动复制本文件；锅巴保存会按 defSet/config.yaml 模板重写它
# 键的含义见 defSet/config.yaml 的注释；本文件的值必须与 src/components/config.ts 的 defaultConfig 一致
# （test/config.test.mjs 会逐字段核对）

# 常规查询命令的优先级（数字越小越先执行）
# ⚠ 攻略模块的「抢占用」优先级写死为 -100000，不在此处暴露
priority: 8000

# 渲染缩放比例
renderScale: 1.5

# 模块开关（功能层：该模块的命令是否响应）
# true = 可用；false = 不响应（非接管类回提示；接管类「#胡桃攻略 / 帮助页」放行给其他插件）
# ⚠ 与下面的 networkEnabled（只管查询类远程访问）正交
modules:
  codex: true
  help: true
  rank: true
  raidTiers: true
  grade: true
  # 队伍伤害：默认关闭（用户 2026-10-15 定）
  teamDamage: false
  video: true
  status: true
  admin: true

# 业务查询联网开关（默认关闭）
# 只管辖 DPS 榜 / 危战 / 练度等业务查询的远程访问与刷新；**不是**整个插件的全局联网禁令
networkEnabled: false

# 抓取 mhydps.cn 的代理，留空 = 直连
proxy: ""

# 榜单单次请求超时（毫秒）
dpsTimeoutMs: 30000

# 榜单数据缓存有效期（分钟）
dpsCacheTtlMinutes: 30

# 榜单每页条数
dpsPageSize: 10

# 是否缓存并渲染角色立绘
dpsAvatarEnabled: true

# 练度评分权重（综合 / 武器 / 天赋；「综合」= 圣遗物有效词条为主 + 套装符合度）
gradeWeights: "comprehensive:65,weapon:20,talent:15"

# 面板三档阈值：大毕业 / 毕业 / 小毕业（按面板目标平均达成度）
gradePanelTiers: "big:0.9,normal:0.6,small:0.3"

# 总体练度九档阈值（MAX/ACE/SSS/SS/S/A/B/C，低于最后一项记 D）
gradeRankThresholds: "MAX:95,ACE:88,SSS:80,SS:72,S:64,A:55,B:45,C:30"

# 练度评分规则（每个角色一套，2026-10-25）
# auto = 按数据表 data/gi/_grade-rules.json 逐角色执行（推荐）；也可强制 dps / subdps / support / custom
gradeRule: "auto"

# 仅 custom：分量权重（mark 词条 / set 套装 / main 主词条 / panel 面板），留空 = 四等分
gradeRuleWeights: ""

# 逐角色覆盖（部署侧临时纠偏，优先级最高）：胡桃:dps,钟离:support
gradeRuleOverrides: ""

# 仅 custom：加权分达标线（0~1）
gradeRuleMet: "0.9"

# 队伍伤害的序号轴表（`序号:名称=轴定义`，多个轴逗号分隔；`默认` = 每人最高单次×1／20s）
# 例：1:保守轴=默认,2:重击轴=重击×8@20s+元素战技×1
teamDamageAxes: "1:保守轴=默认"
